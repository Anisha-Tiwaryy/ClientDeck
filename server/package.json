{
  "name": "clientdeck-server",
  "version": "1.0.0",
  "description": "ClientDeck API",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env -e \"import('./src/db.js').then(async d=>{await d.migrate();await d.pool.end();console.log('migrated')})\"",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [],
