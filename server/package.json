  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "type": "module"
}